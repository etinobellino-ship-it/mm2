-- ==========================================
-- 1. GOD MODE & CARATTERISTICA
-- ==========================================
if Settings.EnableGodMode then
    task.spawn(function()
        local Char = LocalPlayer.Character
        local Humanoid = Char and Char:FindFirstChild("Humanoid")
        if Humanoid then
            Humanoid.MaxHealth = math.huge
            Humanoid.Health = math.huge
            print("God Mode Attivato")
        end
    end)
end

if Settings.EnableSpeed then
    task.spawn(function()
        local Char = LocalPlayer.Character
        local Humanoid = Char and Char:FindFirstChild("Humanoid")
        if Humanoid then
            Humanoid.WalkSpeed = Settings.SpeedValue
        end
    end)
end

-- ==========================================
-- 2. FLY HACK
-- ==========================================
if Settings.EnableFly then
    local FlyEnabled = false
    
    local function ToggleFly()
        FlyEnabled = not FlyEnabled
        if FlyEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            if Root then
                Root.Velocity = Vector3.new(0, 0, 0)
                Workspace.Gravity = 0
                print("Fly Attivato")
            end
        else
            Workspace.Gravity = 196.2
            print("Fly Disattivato")
        end
    end
    
    local function OnInput(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Space then
            ToggleFly()
        end
    end
    
    UserInputService.InputBegan:Connect(OnInput)
    
    -- Gestione movimento volo
    RunService.RenderStepped:Connect(function()
        if FlyEnabled then
            local Char = LocalPlayer.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            if Root then
                local mouse = LocalPlayer:GetMouse()
                local direction = Vector3.new(mouse.Hit.p.X - Root.Position.X, 0, mouse.Hit.p.Z - Root.Position.Z)
                Root:MoveTo(Root.Position + direction * 100)
            end
        end
    end)
end

-- ==========================================
-- 3. AUTO FARM (MONETE E CARAMELLE)
-- ==========================================
if Settings.EnableAutoFarm then
    task.spawn(function()
        while true do
            task.wait()
            local Char = LocalPlayer.Character
            if not Char then continue end
            
            local Humanoid = Char:FindFirstChild("Humanoid")
            if Humanoid.Health <= 0 then continue end
            
            local Nearest = nil
            local MinDist = 1000
            
            -- Cerca oggetti (Coin, Candy, ecc.)
            for _, v in pairs(Workspace:GetDescendants()) do
                if (v.Name == "Coin" or v.Name == "Candy") and v:IsA("BasePart") then
                    local dist = (v.Position - Char.PrimaryPart.Position).Magnitude
                    if dist < MinDist then
                        MinDist = dist
                        Nearest = v
                    end
                end
            end
            
            if Nearest and MinDist < 500 then
                Humanoid:MoveTo(Nearest.Position)
            end
        end
    end)
end

-- ==========================================
-- 4. ESP & VISUALS (HIGHLIGHT, RAYCAST, ROLE)
-- ==========================================
local ESP = {}
local HighlightFolder = Instance.new("Folder")
HighlightFolder.Name = "ESP_Highlights"
HighlightFolder.Parent = LocalPlayer

-- Funzione per rilevare il ruolo
local function GetRole(Player)
    local Char = Player.Character
    if not Char then return "Innocente" end
    
    local Backpack = Player.Backpack
    if Backpack:FindFirstChild("Knife") then return "Assassino" end
    if Char:FindFirstChild("Gun") or Char:FindFirstChild("GunPart") then return "Sceriffo" end
    return "Innocente"
end

