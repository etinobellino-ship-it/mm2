-- ==========================================
-- MM2 Xeno Executor - Script Ottimizzato
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Camera = workspace.CurrentCamera

-- Gestione errore iniziale
local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local mouse = LocalPlayer:GetMouse()

-- ==========================================
-- 🎛️ CONFIGURAZIONE
-- ==========================================
local Settings = {
    GodMode = true,
    Fly = false,
    Speed = true,
    SpeedVal = 50,
    AutoFarm = true,
    AutoFarmKey = Enum.KeyCode.G,
    AutoClick = false,
    ESP = true,
    ShowDistance = true,
    SilentAim = false,
    KillAuraRange = 15,
}

-- ==========================================
-- 🛡️ GOD MODE & SPAZIO
-- ==========================================
local function setupCharacter()
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    
    if Settings.GodMode then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end
    
    if Settings.Speed then
        hum.WalkSpeed = Settings.SpeedVal
    end
    
    flyEnabled = false
end

char.ChildAdded:Connect(setupCharacter)
setupCharacter()

-- ==========================================
-- 🚀 FLY HACK (Premi 'F' per attivare/disattivare)
-- ==========================================
local flyEnabled = false
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        flyEnabled = not flyEnabled
        if flyEnabled then
            char:WaitForChild("HumanoidRootPart").Velocity = Vector3.new(0,0,0)
            Workspace.Gravity = 0
        else
            Workspace.Gravity = 196.2
        end
    end
end)

-- ==========================================
-- 🪙 AUTO FARM (Premi 'G' per attivare/disattivare)
-- ==========================================
local function findNearestItem()
    local nearest = nil
    local minDist = 500
    local itemTypes = {"Coin", "Candy", "Crown", "Key"}
    
    for _, type in pairs(itemTypes) do
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == type and obj:IsA("BasePart") then
                local dist = (obj.Position - char.PrimaryPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

if Settings.AutoFarm then
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Settings.AutoFarmKey then
            while Settings.AutoFarm do
                local item = findNearestItem()
                if item then
                    char:WaitForChild("Humanoid"):MoveTo(item.Position)
                end
                task.wait(0.1)
            end
        end
    end)
end

-- ==========================================
-- 👁️ ESP & VISUALS SYSTEM
-- ==========================================
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESP_Highlights"
ESPFolder.Parent = LocalPlayer

local function getRole(player)
    local bp = player:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild("Knife") then return "Assassino" end
    local char = player.Character
    if char and char:FindFirstChild("Gun") then return "Sceriffo" end
    return "Innocente"
end

RunService.RenderStepped:Connect(function()
    if not Settings.ESP then return end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = p.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then continue end
        
        local role = getRole(p)
        local root = c:FindFirstChild("HumanoidRootPart")
        local head = c:FindFirstChild("Head")
        
        -- Colori basati sul ruolo
        local color = Color3.fromRGB(255, 255, 255)
        if role == "Assassino" then color = Color3.fromRGB(255, 0, 0)
        elseif role == "Sceriffo" then color = Color3.fromRGB(0, 0, 255)
        else color = Color3.fromRGB(0, 255, 0) end
        
        -- Highlight (Chams)
        local hl = ESPFolder:FindFirstChild(p.Name)
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = p.Name
            hl.FillColor = color
            hl.OutlineColor = color
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.6
            hl.Parent = ESPFolder
        end
        hl.Adornee = c
        hl.FillColor = color
        
        -- Line of Sight (Raycast)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {c}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local ray = Workspace:Raycast(root.Position, (head.Position - root.Position).Unit * 10, rayParams)
        
        local dist = (root.Position - char.PrimaryPart.Position).Magnitude
        
        -- Disegna linea di distanza (Semplice Part come Line)
        local line = c:FindFirstChild("DistLine_" .. p.Name)
        if not line then
            line = Instance.new("Part")
            line.Name = "DistLine_" .. p.Name
            line.Shape = Enum.PartType.Cylinder
            line.Size = Vector3.new(0.5, 0.5, 1)
            line.Anchored = true
            line.CanCollide = false
            line.Parent = c
        end
        
        -- Orienta la linea
        line.CFrame = CFrame.lookAt(root.Position, head.Position) * CFrame.new(0, 0, 5)
        
        if ray then
            line.Color = Color3.fromRGB(255, 0, 0) -- Rosso (Nascosto)
            line.Transparency = 0.5
        else
            line.Color = Color3.fromRGB(0, 255, 0) -- Verde (Visibile)
            line.Transparency = 0.2
        end
        
        -- Distanza Tracker Text
        if Settings.ShowDistance and dist < 100 then
            local billboard = c:FindFirstChild("DistText_" .. p.Name)
            if not billboard then
                billboard = Instance.new("BillboardGui")
                billboard.Name = "DistText_" .. p.Name
                billboard.Size = UDim2.new(0, 100, 0, 30)
                billboard.StudsOffset = Vector3.new(0, 4, 0)
                billboard.Parent = head
            end
            local txt = billboard:FindFirstChild("DistanceLabel")
            if not txt then
                txt = Instance.new("TextLabel")
                txt.Name = "DistanceLabel"
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                txt.TextStrokeTransparency = 0.5
                txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                txt.TextScaled = true
                txt.Parent = billboard
            end
            txt.Text = math.floor(dist) .. " studs"
        end
    end
end)

-- ==========================================
-- 🗡️ AUTO CLICK & SILENT AIM
-- ==========================================
UserInputService.InputBegan:Connect(function(input)
    if not Settings.AutoClick then return end
    
    -- Controlla arma attuale
    local weapon = char:FindFirstChildOfClass("Tool")
    if not weapon or weapon.Name ~= "Knife" then return end
    
    local hum = char:WaitForChild("Humanoid")
    if hum.Health <= 0 then return end
    
    -- Trova nemici vicini
    local nearest = nil
    local minDist = Settings.KillAuraRange
    
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local role = getRole(p)
        if role == "Innocente" then
            local dist = (p.Character.PrimaryPart.Position - char.PrimaryPart.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = p
            end
        end
    end
    
    if nearest then
        -- Auto Click
        mouse.Button1Down:Fire()
        mouse.Button1Up:Fire()
    end
end)

print("[Xeno MM2] Script Caricato con successo!")
