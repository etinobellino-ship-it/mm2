-- Utility Functions
local function GetDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function GetRole(player)
    local char = player.Character
    if not char then return "Innocent" end
    
    local backpack = player:FindFirstChild("Backpack")
    local knife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
    local gun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")
    
    if knife then return "Murderer" end
    if gun then return "Sheriff" end
    return "Innocent"
end

-- ESP System
local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local esp = {
        Box = nil,
        Tracer = nil,
        Name = nil,
        Distance = nil,
        Highlight = nil
    }
    
    -- Highlight (Chams)
    local highlight = Instance.new("Highlight")
    highlight.Name = player.Name .. "_ESP"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = CoreGui
    
    -- Billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Name = player.Name .. "_Billboard"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = CoreGui
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Parent = billboard
    
    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.5, 0)
    distLabel.Position = UDim2.new(0, 0, 0.5, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.new(1, 1, 1)
    distLabel.TextStrokeTransparency = 0
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 12
    distLabel.Parent = billboard
    
    esp.Highlight = highlight
    esp.Billboard = billboard
    esp.NameLabel = nameLabel
    esp.DistLabel = distLabel
    
    ESPObjects[player] = esp
end

local function UpdateESP()
    for player, esp in pairs(ESPObjects) do
        if not player.Parent then
            esp.Highlight:Destroy()
            esp.Billboard:Destroy()
            ESPObjects[player] = nil
            continue
        end
        
        local char = player.Character
        if not char then continue end
        
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        
        local role = GetRole(player)
        local color = Config.ESP.InnocentColor
        
        if role == "Murderer" then
            color = Config.ESP.MurdererColor
        elseif role == "Sheriff" then
            color = Config.ESP.SheriffColor
        end
        
        esp.Highlight.FillColor = color
        esp.Highlight.OutlineColor = color
        esp.Highlight.Adornee = char
        
        esp.Billboard.Adornee = root
        esp.NameLabel.Text = player.Name .. " [" .. role .. "]"
        esp.NameLabel.TextColor3 = color
        
        if Config.ESP.Distance then
            local dist = math.floor(GetDistance(HumanoidRootPart.Position, root.Position))
            esp.DistLabel.Text = dist .. " studs"
            esp.DistLabel.Visible = true
        else
            esp.DistLabel.Visible = false
        end
        
        -- Line of Sight Raycast
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        
        local direction = (root.Position - HumanoidRootPart.Position).Unit * 1000
        local raycastResult = Workspace:Raycast(HumanoidRootPart.Position, direction, raycastParams)
        
        if raycastResult and raycastResult.Instance:IsDescendantOf(char) then
            esp.NameLabel.TextColor3 = Color3.fromRGB(0, 255, 0) -- Line of sight (green)
        else
            esp.NameLabel.TextColor3 = color -- Behind wall
        end
    end
end

-- Role Detection
local function DetectRoles()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local role = GetRole(player)
            RoleData[player] = role
            
            if player == LocalPlayer then
                IsMurderer = (role == "Murderer")
                IsSheriff = (role == "Sheriff")
            end
        end
    end
end

-- Kill Aura (Murderer)
local function KnifeAura()
    if not IsMurderer or not Config.KillAura.Enabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = GetDistance(HumanoidRootPart.Position, root.Position)
                if dist <= Config.KillAura.Range then
                    -- Trigger knife hit
                    local knife = LocalPlayer.Character:FindFirstChild("Knife")
                    if knife then
                        local args = {
                            [1] = player.Character:FindFirstChild("Humanoid"),
                            [2] = root.Position
                        }
                        
                        -- RemoteEvent hooking
                        local success, err = pcall(function()
                            Remotes:WaitForChild("Throw"):FireServer(unpack(args))
                        end)
                    end
                end
            end
        end
    end
end

-- Silent Aim (Sheriff)
local function SilentAim()
    if not IsSheriff or not Config.SilentAim.Enabled then return end
    
    local closestPlayer = nil
    local shortestDistance = Config.SilentAim.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetRole(player) == "Murderer" then
            if player.Character and player.Character:FindFirstChild(Config.SilentAim.HitPart) then
                local pos = player.Character[Config.SilentAim.HitPart].Position
                local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(pos)
                
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    if closestPlayer then
        -- Metatable hooking per silent aim
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local old_index = mt.__index
        
        mt.__index = function(self, key)
            if self:IsA("Mouse") and key == "Hit" then
                return closestPlayer.Character[Config.SilentAim.HitPart].CFrame
            end
            return old_index(self, key)
        end
        
        setreadonly(mt, true)
    end
end

-- Auto Farm
local function AutoFarm()
    if not Config.AutoFarm.Enabled then return end
    
    local coins = Workspace:FindFirstChild("CoinContainer")
    if coins then
        for _, coin in ipairs(coins:GetChildren()) do
            if coin:IsA("BasePart") then
                if Config.AutoFarm.NoClip then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = coin.CFrame
                else
                    local tween = TweenService:Create(
                        LocalPlayer.Character.HumanoidRootPart,
                        TweenInfo.new(GetDistance(LocalPlayer.Character.HumanoidRootPart.Position, coin.Position) / Config.AutoFarm.Speed),
                        {CFrame = coin.CFrame}
                    )
                    tween:Play()
                    tween.Completed:Wait()
                end
                wait(0.1)
            end
        end
    end
    
    -- Gun Drop Finder
    local gunDrop = Workspace:FindFirstChild("GunDrop")
    if gunDrop and Config.AutoFarm.CollectGuns then
        LocalPlayer.Character.HumanoidRootPart.CFrame = gunDrop.CFrame
    end
end

-- Movement Hacks
local function UpdateMovement()
    if Humanoid then
        Humanoid.WalkSpeed = Config.Movement.Speed
        Humanoid.JumpPower = Config.Movement.JumpPower
    end
    
    -- Fly
    if Config.Movement.Fly then
        if not FlyConnection then
            FlyConnection = RunService.RenderStepped:Connect(function()
                local camCF = workspace.CurrentCamera.CFrame
                local moveDir = Vector3.new()
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    moveDir = moveDir + camCF.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    moveDir = moveDir - camCF.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    moveDir = moveDir - camCF.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    moveDir = moveDir + camCF.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveDir = moveDir + Vector3.new(0, 1, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                    moveDir = moveDir - Vector3.new(0, 1, 0)
                end
                
                if moveDir.Magnitude > 0 then
                    HumanoidRootPart.Velocity = moveDir.Unit * Config.Movement.FlySpeed * 50
                else
                    HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                end
                
                Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            end)
        end
    else
        if FlyConnection then
            FlyConnection:Disconnect()
            FlyConnection = nil
        end
    end
    
    -- NoClip
    if Config.Movement.NoClip then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    -- God Mode
    if Config.Movement.GodMode then
        if LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.Name = "Humanoid_GodMode"
        end
    end
end

-- X-Ray Vision
local function ToggleXRay(state)
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character) then
            if state then
                part.Transparency = 0.7
                if part:FindFirstChild("OriginalTransparency") then
                    part:SetAttribute("OriginalTransparency", part.Transparency)
                end
            else
                local original = part:GetAttribute("OriginalTransparency")
                if original then
                    part.Transparency = original
                else
                    part.Transparency = 0
                end
            end
        end
    end
end

-- Anti-Detection
local function AntiDetection()
    -- Anti AFK
    if Config.AntiDetection.AntiAFK then
        local vu = game:GetService("VirtualUser")
        LocalPlayer.Idled:Connect(function()
            vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            wait(1)
            vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        end)
    end
    
    -- Auto Leave on Staff
    if Config.AntiDetection.AutoLeaveStaff then
        for _, player in ipairs(Players:GetPlayers()) do
            if table.find(StaffIds, player.UserId) then
                LocalPlayer:Kick("Staff detected - Auto protection activated")
            end
        end
        
        Players.PlayerAdded:Connect(function(player)
            if table.find(StaffIds, player.UserId) then
                LocalPlayer:Kick("Staff joined - Auto protection activated")
            end
        end)
    end
    
    -- Streamer Mode
    if Config.AntiDetection.StreamerMode then
        LocalPlayer.Name = "Player_" .. math.random(1000, 9999)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
            local head = LocalPlayer.Character.Head
            if head:FindFirstChild("Nametag") then
                head.Nametag:Destroy()
            end
        end
    end
end

-- Trolling Functions
local function FlingPlayer(player)
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(math.random(-5000, 5000), math.random(-5000, 5000), math.random(-5000, 5000))
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = player.Character.HumanoidRootPart
        
        game:GetService("Debris"):AddItem(bodyVelocity, 0.5)
    end
end

local function ServerLag()
    while Config.Trolling.LagServer do
        for i = 1, 1000 do
            Remotes:FireServer("Equip", math.random())
        end
        wait()
    end
end

